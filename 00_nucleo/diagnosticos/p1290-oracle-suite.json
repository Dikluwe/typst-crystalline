  "fragment": "public repr morphology for arrays/tuples and Content::MathOp",
  "outcome_semantics": {
    "Preserved": "A positive case has an actual string byte-for-byte equal to the canonical expected string.",
    "Violated": "A positive case is missing, duplicated, structurally invalid, out of the required order, unstable across repetition, or differs byte-for-byte from the canonical expected string.",
    "Unknown": "The case is deliberately opaque under the frozen contract. Any observation for it remains Unknown and never contributes a passing result."
  },
  "candidate_protocol": {
