    "required_runs": [
      "canonical-1",
      "canonical-2",
      "reverse-1"
    ],
    "canonical-1": "Every positive case exactly once, in suite order.",
    "canonical-2": "An exact repetition of canonical-1, including order and actual strings.",
    "reverse-1": "Every positive case exactly once, in exact reverse suite order, with the same actual strings.",
    "opaque_observations": "Optional list of opaque case observations. Every listed item is classified Unknown and makes validation fail; omission makes no claim about opaque behavior.",
    "success": "All required positive observations and both determinism checks are Preserved, and no Unknown or Violated outcome is present."
  },
