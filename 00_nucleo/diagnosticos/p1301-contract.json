  "verdict_function": {
    "required_case": [
      "return Preserved only when every expected observable equals the actual observable",
      "return Violated with the first differing observable as witness when execution completed and comparison is decidable",
      "return Unknown only when the observation cannot be decided from public inputs; Unknown still fails the required-case gate"
    ],
    "opaque_case": [
      "return Unknown only for an id listed in deliberately_opaque_cases and only with its exact reason_code",
      "Preserved or Violated on an opaque fixture fails the opacity-control gate"
    ],
    "default_unknown_handling": "FAIL",
    "execution_unknown_handling": "FAIL",
    "semantic_unknown_in_required_case": "FAIL"
  },
