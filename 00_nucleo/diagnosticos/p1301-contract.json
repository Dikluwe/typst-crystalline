  "binding_free_boundary": {
    "allowed_inputs": [
      "Typst source expression",
      "public CLI profile arguments",
      "process exit code",
      "stdout bytes",
      "stderr bytes",
      "public diagnostic class, message, hints, and source span"
    ],
    "forbidden_dependencies": [
      "Rust symbol names",
      "function or pointer identity",
      "internal module storage name",
      "lookup control flow",
      "candidate implementation",
      "candidate tests",
      "per-field implementation blacklist"
    ],
    "runner_command": [
      "<typst-binary>",
      "--color",
      "never",
      "eval",
      "<profile-argv...>",
      "--diagnostic-format",
      "short",
      "<expression>"
    ],
    "span_model": "zero-based, half-open UTF-8 byte range within the expression; the short diagnostic column equals span.start",
    "comparison": "byte-exact for stdout and rendered stderr; exact equality for exit_code, diagnostic class, message, ordered hints, and span"
  },
  "categorical_rule": {
    "domain": "every public field access whose evaluated target is semantically a module and whose requested field is absent",
    "missing_field": {
      "diagnostic_class": "error",
      "message_template": "module `<public-module-name>` does not contain `<field>`",
      "hints": [],
      "span": "only the field identifier to the right of the final dot",
      "exit_code": 1,
      "stdout": "",
      "stderr": "the exact short-format diagnostic line plus only profile-mandated warnings"
    },
    "public_name_projection": {
      "ordinary_module": "the module's public name",
      "standard_module_reached_as_std": "global",
      "prohibition": "the std-to-global projection is semantic identity, never a list or test of field names"
    },
    "existing_field": "preserve the resolved value and its public kind, exit successfully, and emit no error diagnostic",
    "non_module": "preserve its pre-P1301 diagnostic span and behavior, except independent rules already frozen by their own L0",
    "prohibitions": [
      "no public API, entity, default, compatibility, evaluation-order, or pipeline-phase change",
      "no reflection, wrapper, fallback, or field blacklist",
      "no repair of repr(std)"
    ]
  },
  "profiles": {
