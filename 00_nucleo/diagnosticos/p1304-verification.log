  "final_audit_source": "import json,hashlib,base64,collections,math,subprocess,re,datetime\nfrom pathlib import Path\nD=Path('00_nucleo/diagnosticos')\ndef load(n):return json.loads((D/n).read_text())\ndef sha(b):return hashlib.sha256(b).hexdigest()\nissues=[]; checks=0\ndef check(cond,label):\n global checks\n checks+=1\n if not cond:issues.append(label)\nm=load('p1304-feature-matrix.json'); c=load('p1304-probe-catalog.json'); h=load('p1299-probe-catalog.json')\ncheck(sha((D/'p1304-feature-matrix.json').read_bytes())=='7679f2438f59a3fdf3d17760f1398b3058b130b7c79f6234b86932fbecb810fb','matrix pin')\ncheck(c['probes'][:626]==h['probes'],'historical 626 verbatim')\ncheck(len(c['probes'])==627 and len({p['id'] for p in c['probes']})==627,'627 unique')\nprofiles={'default':[],'html':['html'],'a11y':['a11y-extras'],'html+a11y':['html','a11y-extras']}\ndef classify(v,c):\n if not v.get('complete',v.get('state')=='COMPLETE') or not c.get('complete',c.get('state')=='COMPLETE'):return 'EXECUTION_UNKNOWN'\n ve,ce=v['exit_code'],c['exit_code']\n if ve==ce==0:\n  try:a=json.loads(v['stdout']);b=json.loads(c['stdout'])\n  except ValueError:return 'EXECUTION_UNKNOWN'\n  return 'MATCH_VALUE' if a==b else 'DIFFERENT_VALUE'\n if ve==0:return 'VANILLA_ONLY'\n if ce==0:return 'CRYSTALLINE_ONLY'\n return 'MATCH_DIAGNOSTIC' if ve==ce and v['stderr']==c['stderr'] else 'DIFFERENT_DIAGNOSTIC'\nrows=m['results']+m['inverted_results']+m['supplement']['normal_results']+m['supplement']['inverted_results']\nfor r in rows:\n key='/'.join([r['phase'],r['id'],r['profile']])\n check(classify(r['vanilla'],r['crystalline'])==r['runtime_class'],'class '+key)\n check(r['runtime_class']!='EXECUTION_UNKNOWN','unknown '+key)\n for s in ['vanilla','crystalline']:\n  x=r[s]\n  for f in ['stdout','stderr']:\n   raw=base64.b64decode(x[f+'_base64'],validate=True)\n   check(sha(raw)==x[f+'_sha256'] and raw.decode()==x[f],'output '+key+'/'+s+'/'+f)\n  argv=[m['binaries'][s]['path'],'eval',r['expression'],'--format','json']\n  if profiles[r['profile']]:argv+=['--features',','.join(profiles[r['profile']])]\n  check(x['argv']==argv and x['binary_sha256']==m['binaries'][s]['sha256'],'argv '+key+'/'+s)\n  check(isinstance(x['duration_ns'],int) and x['duration_ns']>0,'duration '+key+'/'+s)\ncheck(len(m['results'])==2508,'normal cardinality')\nexpected=[(p['id'],profile) for profile in profiles for p in c['probes']]\ncheck([(r['id'],r['profile']) for r in m['results']]==expected,'normal exact jobs/order')\nclasssets=collections.defaultdict(set)\nfor r in m['results']:classsets[r['id']].add(classify(r['vanilla'],r['crystalline']))\nmatching=[i for i,classes in classsets.items() if classes<={'MATCH_VALUE','MATCH_DIAGNOSTIC'}]\nsample=sorted(matching,key=lambda i:(sha(i.encode()),i))[:math.ceil(.05*len(matching))]\ncheck(sample==m['repetition']['sample_ids'],'sample deterministic')\nnonmatch={r['path'] for r in m['results'] if not r['runtime_class'].startswith('MATCH_')}\nmandatory={'hsl','hsv','linear_rgb','std.hsl','std.hsv','std.linear_rgb','calc.nope','sym.nope','color.map.nope','std.rgb','calc.abs','sym.arrow','color.map.turbo','color.hsl','color.hsv','color.linear-rgb','pdf.data-cell','pdf.header-cell','pdf.table-summary'}\nselected={p['id'] for p in c['probes'] if p['path'] in nonmatch|mandatory or p['id']=='p1304-repr-std' or p['id'] in sample}\ncheck([(r['id'],r['profile']) for r in m['inverted_results']]==[k for k in reversed(expected) if k[0] in selected],'inverse exact jobs/order')\noriginal={(r['id'],r['profile']):r for r in m['results']+m['supplement']['normal_results']}\nfor r in m['inverted_results']+m['supplement']['inverted_results']:\n old=original[r['id'],r['profile']]\n for s in ['vanilla','crystalline']:\n  check(all(r[s][f]==old[s][f] for f in ['exit_code','stdout_base64','stderr_base64','complete','reason_code']),'repeat '+r['id']+'/'+r['profile']+'/'+s)\ncounts=collections.Counter(r['runtime_class'] for r in m['results'])\ncheck(dict(counts)==m['counts']['normal_by_class'],'class counts')\nfor p in profiles:check(dict(collections.Counter(r['runtime_class'] for r in m['results'] if r['profile']==p))==m['counts']['normal_by_profile'][p],'profile count '+p)\nsentinels={}\nfor path in sorted(mandatory):\n rr=[r for r in m['results']+m['supplement']['normal_results'] if r['path']==path]\n check(len(rr)==4,'sentinel coverage '+path)\n sentinels[path]={r['profile']:r['runtime_class'] for r in rr}\n for r in rr:\n  cl=r['runtime_class']\n  if path in {'hsl','hsv','linear_rgb','std.hsl','std.hsv','std.linear_rgb','calc.nope','sym.nope','color.map.nope'}:check(cl=='MATCH_DIAGNOSTIC','sentinel diagnostic '+path)\n  elif path.startswith('pdf.'):check(cl==('MATCH_VALUE' if 'a11y' in r['profile'] else 'MATCH_DIAGNOSTIC'),'pdf gate '+path)\n  elif path=='color.map.turbo':check(r['vanilla']['exit_code']==r['crystalline']['exit_code']==0,'turbo success')\n  else:check(cl=='MATCH_VALUE','sentinel value '+path)\nbaseline_text=(D/'p1304-baseline-status.txt').read_text(); baseline=json.JSONDecoder().raw_decode(baseline_text[baseline_text.index('{'):])[0]\nhead=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip();diff=subprocess.check_output(['git','diff','HEAD','--binary'])\ncheck(head==baseline['head'],'head');check(sha(diff)==baseline['diff_binary_sha256'],'diff pin')\nfor x in baseline['current_dirty_paths']+baseline['inputs']:check(sha(Path(x['path']).read_bytes())==x['sha256'],'baseline input '+x['path'])\np3=load('p1303-verification-receipt.json')\ncheck(sha((D/'p1303-verification-receipt.json').read_bytes())=='73243cecb10eb26ba4c7c5631939f7e5a8315134fcd9cf68a64221f3925e9e39','p3 receipt pin')\ncheck(head==p3['source_state']['baseline_commit'],'p3 head')\nfor p,x in p3['source_state']['file_hashes'].items():check(sha(Path(p).read_bytes())==x['sha256'],'p3 input '+p)\nworkspace=[e for e in p3['ordered_final_gates']['events_with_integral_outputs'] if e['argv']==['cargo','test','--workspace']]\ncheck(len(workspace)==1 and workspace[0]['exit_code']==0,'workspace receipt pass')\nfor f in ['stdout','stderr']:check(sha(workspace[0][f].encode())==workspace[0][f+'_sha256'],'workspace output hash')\nrefinements={}\nfor n,pin in [('p1304-repr-refinement.json','6b300e95e456fd36828e68f8b15889af2a8184e514ee5be57ad2c8c1c0b4f6d2'),('p1304-encode-readiness.json','156f56b9f65ad5fd4310aa7785d4667c1f2c20e13f3f5c8be43b280700e7b950')]:\n d=load(n);check(sha((D/n).read_bytes())==pin,'refinement pin '+n)\n for prefix in ['measurement','assembly','revision']:check(sha(d[prefix+'_script_source'].encode())==d[prefix+'_script_sha256'],'script '+prefix)\n for x in d['inputs']['owners']+d['inputs']['sources']:check(sha(Path(x['path']).read_bytes())==x['sha256'],'refinement input '+x['path'])\n rc=collections.Counter()\n for row in d['runs']:\n  for profile,sides in row['profiles'].items():\n   cl=classify(sides['vanilla'],sides['crystalline']);rc[cl]+=1\n   check(cl==row['runtime_class_by_profile'][profile],'ref class '+row['id']+'/'+profile)\n   for s,x in sides.items():\n    check(x['state']=='COMPLETE','ref unknown '+row['id'])\n    for f in ['stdout','stderr']:check(sha(x[f].encode())==x[f+'_sha256'],'ref output '+row['id']+'/'+s)\n    if x['exit_code']==0:check(json.loads(x['stdout'])==x['value'],'value projection '+row['id']+'/'+s)\n check(dict(rc)==d['counts']['runtime_classes'],'ref counts '+n)\n refinements[n]={'counts':dict(rc),'probes':len(d['runs'])}\n if d['phase']=='D':\n  for entry in d['map_measurements']:\n   row=next(r for r in d['runs'] if r['id']=='map/'+entry['path'].split('.')[-1])\n   for profile,pair in entry['profiles'].items():\n    for side in ['vanilla','crystalline']:\n     data=row['profiles'][profile][side]['value'];x=pair[side]\n     check(data['n']==len(data['rgba'])==len(data['hex'])==x['cardinality'],'map cardinality')\n     tokens=['0x'+hx[1:].lower()+('ff' if len(hx)==7 and rgba[3]==1 else '') for hx,rgba in zip(data['hex'],data['rgba'])]\n     canonical=','.join(tokens