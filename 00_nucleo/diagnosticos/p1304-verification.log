r hash')\npins=[]\ndef walkpins(x):\n if isinstance(x,dict):\n  if isinstance(x.get('path'),str) and isinstance(x.get('sha256'),str):\n   raw=Path(x['path']).read_bytes();check(sha(raw)==x['sha256'],'manifest pin '+x['path'])\n   if 'bytes' in x:check(len(raw)==x['bytes'],'manifest bytes '+x['path'])\n   pins.append({'path':x['path'],'sha256':x['sha256']})\n  for v in x.values():walkpins(v)\n elif isinstance(x,list):\n  for v in x:walkpins(v)\nwalkpins(manifest)\nowners=manifest['audited_owner_pairs']\ncheck(len(owners)==29,'29 owners')\nscan_argv=['rg','-n','^//! @prompt ','01_core','02_shell','03_infra','04_wiring','-g','*.rs']\nscan=subprocess.check_output(scan_argv,text=True)\nowner_check=[]\nfor pair in owners:\n pp=pair['prompt']['path']; cp=pair['consumer']['path'];pt=Path(pp).read_text();ct=Path(cp).read_text()\n hits=[s for s in scan.splitlines() if s.endswith('//! @prompt '+pp)]\n check(len(hits)==1 and hits[0].startswith(cp+':'),'1:1 '+pp)\n check(re.search(r'Hash do Código:\\s*(\\w+)',pt).group(1)==pair['declared_code_hash'],'declared '+pp)\n check(re.findall(r'^//! @prompt (\\S+)',ct,re.M)==[pp],'consumer single owner '+cp)\n owner_check.append({'prompt':pp,'consumer':cp,'one_to_one':len(hits)==1,'prompt_sha256':sha(pt.encode()),'consumer_sha256':sha(ct.encode())})\nledger=list(csv.DictReader((D/'p1304-owner-ledger.tsv').open(),delimiter='\\t'))\noldledger=list(csv.DictReader((D/'p1299-owner-ledger.tsv').open(),delimiter='\\t'))\nnewby={r['path']:r for r in ledger};oldby={r['path']:r for r in oldledger}\ncheck(len(ledger)==len(newby)==167,'167 unique ledger paths')\ncheck(set(newby)==set(oldby)|{'repr(std)'},'historical paths preserved plus repr std')\nclosed={'hsl','hsv','linear_rgb','pdf.data-cell','pdf.header-cell','pdf.table-summary'}\ncheck({r['path'] for r in ledger if r['current_language_class']=='CLOSED_CONFIRMED'}==closed,'six closed exact')\ncheck({r['path'] for r in ledger if r['universe']=='p1299_residual_160'}==set(oldby)-closed,'160 residuals exact')\nowner_by={x['prompt']['path']:x for x in owners}\nledger_classes=collections.Counter()\nfor row in ledger:\n path=row['path'];cl=row['current_language_class'];ledger_classes[cl]+=1\n check(row['owner_prompt'] in owner_by,'ledger owner inventoried '+path)\n pp=owner_by[row['owner_prompt']]\n check(row['owner_prompt_sha256']==pp['prompt']['sha256'] and row['owner_prompt_hash_declared']==pp['declared_code_hash'],'ledger owner hash '+path)\n actual={profile:original[(row['probe_id'],profile)]['runtime_class'] for profile in profiles}\n declared=dict(v.split(':',1) for v in row['runtime_class_by_profile'].split(';'))\n check(actual==declared,'ledger runtime '+path)\n if path in oldby:check(row['previous_class']==oldby[path]['language_class'],'previous class '+path)\n check(all(row[k] for k in ['l0_claim','inference','refutation','recommended_action','crystalline_owner_file_line','vanilla_source_file_line']),'row completeness '+path)\n if cl=='MISSING_LANGUAGE_MEMBER':check('VANILLA_ONLY' in actual.values() and set(actual.values())<={'VANILLA_ONLY','MATCH_DIAGNOSTIC'},'missing class '+path)\n elif cl=='INTENTIONAL_PRODUCT_EXTENSION':check(set(actual.values())=={'CRYSTALLINE_ONLY'},'extension class '+path)\n elif cl=='WRONG_PUBLIC_REPR':check(set(actual.values())=={'DIFFERENT_VALUE'},'repr class '+path)\n elif cl=='CLOSED_CONFIRMED':check(set(actual.values())<={'MATCH_VALUE','MATCH_DIAGNOSTIC'},'closed class '+path)\n elif cl=='EXPECTED_FEATURE_DISABLED':check(path=='html' and actual=={'default':'MATCH_DIAGNOSTIC','html':'MATCH_VALUE','a11y':'MATCH_DIAGNOSTIC','html+a11y':'MATCH_VALUE'},'html expected gate')\n else:check(False,'unexpected semantic class '+cl)\ncheck(dict(ledger_classes)=={'MISSING_LANGUAGE_MEMBER':106,'INTENTIONAL_PRODUCT_EXTENSION':42,'WRONG_PUBLIC_REPR':12,'CLOSED_CONFIRMED':6,'EXPECTED_FEATURE_DISABLED':1},'semantic totals')\noldmatrix=load('p1299-feature-matrix.json')\nchanges=[];regressions=[]\nfor r in oldmatrix['results']:\n new=original[r['id'],r['profile']]\n if r['runtime_class']!=new['runtime_class']:changes.append({'id':r['id'],'profile':r['profile'],'old':r['runtime_class'],'new':new['runtime_class']})\n if r['runtime_class'].startswith('MATCH_') and not new['runtime_class'].startswith('MATCH_'):regressions.append([r['id'],r['profile']])\ncheck(len(changes)==18 and not regressions,'18 changes no temporal regression')\nselected=sorted(r['path'] for r in ledger if r['current_language_class']=='WRONG_PUBLIC_REPR')\ncheck(selected==sorted(manifest['classifier_selection']['paths']),'selection paths recomputed')\ncheck({newby[p]['owner_prompt'] for p in selected}=={'00_nucleo/prompts/compiler/eval/repr.md'},'selected one owner')\nfinalist_paths=selected+['json.encode','toml.encode','yaml.encode']\nfinalists=[{'path':p,'class':newby[p]['current_language_class'],'profiles':newby[p]['runtime_class_by_profile'],'owner':newby[p]['owner_prompt']} for p in finalist_paths]\ncheck(all(newby[p]['current_language_class']=='MISSING_LANGUAGE_MEMBER' for p in ['json.encode','toml.encode','yaml.encode']),'encoder class')\noptional=load('p1304-repr-refinement.json')['optional_module_observations']\nfor name,pair in optional.items():\n check(pair['vanilla']['argv'][1:]==pair['crystalline']['argv'][1:],'optional exact argv '+name)\n check(pair['vanilla']['fixture_source']==pair['crystalline']['fixture_source'],'optional same fixture '+name)\n for side,rec in pair.items():\n  check(rec['state']=='COMPLETE','optional complete '+name)\n  for f in ['stdout','stderr']:check(sha(rec[f].encode())==rec[f+'_sha256'],'optional hash '+name+'/'+side+'/'+f)\n  check(sha(rec['fixture_source'].encode())==rec['fixture_sha256'],'optional fixture hash')\nstatus=subprocess.check_output(['git','status','--short','--untracked-files=all'],text=True)\nbaseline_paths={x['path'] for x in manifest['baseline']['current_dirty_paths']}\ncurrent_paths={line[3:] for line in status.splitlines()}\ncheck(current_paths<=baseline_paths|set(manifest['