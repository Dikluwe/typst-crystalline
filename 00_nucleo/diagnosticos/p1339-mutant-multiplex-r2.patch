+/// P1339 adversarial apparatus only: explicit process mode, never fixture-driven.
+pub fn p1339_mutant(id: u8) -> bool {
+    let raw = std::env::var("P1339_MUTANT").unwrap_or_else(|_| "0".into());
+    let mode: u8 = raw.parse().expect("invalid P1339_MUTANT mode");
+    assert!(mode <= 20 && mode != 12, "invalid P1339_MUTANT mode");
+    mode == id
+}
