{
  "schema": "tekt-oracles/v1",
  "step": "P1403",
  "attestation": "executado sem atestação de isolamento",
  "limits": {"rlimit_as_kib": 524288, "timeout_seconds": 15, "max_stream_bytes": 65536},
  "bilateral_cases": [
    {"case": "static-identities", "crystalline": "(prefix, page)", "vanila": "(prefix, page)", "exit_both": 0},
    {"case": "numbered-prefix", "crystalline": "[1.]", "vanila": "[1.]", "exit_both": 0},
    {"case": "unnumbered-prefix", "crystalline": "none", "vanila": "none", "exit_both": 0},
    {"case": "roman-page", "crystalline": "[I]", "vanila": "[I]", "exit_both": 0},
    {"case": "second-page", "crystalline": "[2]", "vanila": "[2]", "exit_both": 0},
    {"case": "hierarchical-prefixes", "crystalline": "([1.], [1.1.])", "vanila": "([1.], [1.1.])", "exit_both": 0}
  ],
  "crystalline_additional_cases": [
    {"case": "missing-location", "diagnostic": "heading must have a location", "hint": "try customizing `outline.entry` with a show rule", "exit": 1},
    {"case": "positional-argument-rejected", "diagnostic": "unexpected argument", "exit": 1},
    {"case": "named-argument-rejected", "diagnostic": "unexpected argument", "exit": 1},
    {"case": "contextual-second-roman-page", "pdf_text_contains": "II", "exit": 0},
    {"case": "pipeline-page-store-retained", "location_page_numbering": "I", "exit": 0}
  ],
  "classification": "Preserved"
}
