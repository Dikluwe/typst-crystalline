+// ISOLATED ADVERSARIAL APPARATUS, NOT PRODUCT AND NOT A SOLUTION CANDIDATE.
+// Mode is process configuration only, never selected by fixture/source/output.
+use super::{Args, SourceDiagnostic, SourceResult, Span, Value};
+
+pub(super) fn mode() -> u8 {
+    let value = std::env::var("P1339_ARRAY_MUTANT").unwrap_or_else(|_| "0".into());
+    let parsed = value.parse::<u8>().expect("invalid isolated Array mutant mode");
+    assert!(parsed <= 12, "invalid isolated Array mutant mode");
+    parsed
+}
+
+pub(super) fn convert(args: &Args, callee_span: Span) -> SourceResult<Value> {
+    let mode = mode();
+    let absent = || vec![SourceDiagnostic::error(
+        callee_span, "type array does not have a constructor",
+    )];
+    let mut remaining = args.clone();
+    if mode == 11 {
+        if let Some(index) = remaining.items.iter().position(|v| matches!(v, Value::Bytes(_))) {
+            for _ in 0..index { remaining.remove_positional(0); }
+        }
+    }
+    let Some(Value::Bytes(bytes)) = remaining.items.first() else {
+        if mode == 10 {
+            return Ok(match remaining.items.first().or_else(|| remaining.named.values().next()) {
+                Some(Value::Array(values)) => Value::Array(values.clone()),
+                Some(Value::Version(version)) => Value::Array(version.components.iter().map(|v| Value::Int(*v as i64)).collect()),
+                Some(other) => Value::Array(vec![other.clone()]),
+                None => Value::Array(vec![]),
+            });
+        }
+        return Err(absent());
+    };
+    if mode == 1 { return Err(absent()); }
+    let bytes = bytes.clone();
+    remaining.remove_positional(0).expect("real first positional Bytes");
+    if mode != 8 {
+        if let Some(extra) = remaining.occurrence_sequence().first() {
+            let span = if mode == 9 || extra.span.is_detached() { remaining.span } else { extra.span };
+            let message = match &extra.name {
+                Some(name) => format!("unexpected argument: {name}"),
+                None => "unexpected argument".into(),
+            };
+            return Err(vec![SourceDiagnostic::error(span, message)]);
+        }
+    }
+    if mode == 2 { return Ok(Value::Bytes(bytes)); }
+    let mut octets = bytes.as_slice().to_vec();
+    match mode {
+        4 => octets.reverse(),
+        5 => { octets.pop(); },
+        6 => {
+            let mut seen = [false; 256];
+            octets.retain(|byte| {
+                let fresh = !seen[*byte as usize];
+                seen[*byte as usize] = true;
+                fresh
+            });
+        },
+        _ => {},
+    }
+    if mode == 7 {
+        return Ok(Value::Array(String::from_utf8_lossy(&octets).chars().map(|c| Value::Int(c as u32 as i64)).collect()));
+    }
+    Ok(Value::Array(octets.into_iter().map(|byte| {
+        Value::Int(if mode == 3 { (byte as i8) as i64 } else { byte as i64 })
+    }).collect()))
+}
