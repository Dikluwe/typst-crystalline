  "source": "use typst_core::{compiler::layout::layout, entities::{content::Content,layout_types::{Length,FrameItem},sides::Sides}};\nfn walk(items:&[FrameItem]){for item in items{match item{FrameItem::Text{text,pos,..}=>print!(\"{text:?}@{},{} \",pos.x.0,pos.y.0),FrameItem::Group{items,..}|FrameItem::TextReplacement{items,..}|FrameItem::Semantic{items,..}=>walk(items),_=>{}}}}\nfn main(){for width in [54.0,52.0,50.0,48.0]{\n let body=Content::sequence(vec![Content::text(\"xx 2020\"),Content::text(\".\")]);\n let block=Content::block(body,Some(Length::pt(width)),None,Sides::uniform(Length::ZERO),true);\n let doc=layout(&Content::sequence(vec![block,Content::text(\"OUTSIDE\")]));\n print!(\"width {width}: \");for page in doc.pages{walk(&page.items);}println!();\n}}\n",
