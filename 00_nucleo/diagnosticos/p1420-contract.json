      "UNKNOWN"
    ],
    "axis_definitions": {
      "qualified_state": "Resultado bilateral da forma pública qualificada exata da rota.",
      "alternative_state": "Resultado bilateral da alternativa literal ou math-mode própria da rota, executada independentemente.",
      "route_state": "Composição normativa dos dois subvereditos, controles e recursos."
    },
    "composition": [
      {
        "when": "qualified_state=MATCH",
        "route_state": "MATCH",
        "reason_code": "QUALIFIED_MATCH"
      },
      {
        "when": "qualified_state=DIFFERENCE",
        "route_state": "DIFFERENCE",
        "reason_code": "QUALIFIED_PUBLIC_DIFFERENCE"
      },
      {
        "when": "qualified_state=ABSENT and alternative_state=MATCH",
        "route_state": "PARTIAL",
        "reason_code": "QUALIFIED_ABSENT_ALTERNATIVE_MATCH"
      },
      {
        "when": "qualified_state=ABSENT and alternative_state=DIFFERENCE",
        "route_state": "PARTIAL",
        "reason_code": "QUALIFIED_ABSENT_ALTERNATIVE_DIFFERENCE",
        "backlog_requirement": "Registrar também a diferença nominal da alternativa."
      },
      {
        "when": "qualified_state=ABSENT and alternative_state=ABSENT",
        "route_state": "ABSENT",
        "reason_code": "QUALIFIED_AND_ALTERNATIVE_ABSENT"
      },
      {
        "when": "any mandatory control, identity, execution, resource, qualified probe, alternative probe or projection is inconclusive",
        "route_state": "UNKNOWN",
        "reason_code": "A razão literal da primeira fase inconclusiva deve ser preservada."
      }
    ],
    "precedence": [
      "UNKNOWN_ON_ANY_MANDATORY_INCONCLUSIVE_INPUT",
      "QUALIFIED_MATCH_OR_DIFFERENCE",
      "PARTIAL_ON_QUALIFIED_ABSENT_WITH_CONCLUSIVE_ALTERNATIVE",
      "ABSENT_ONLY_WHEN_BOTH_FORMS_ARE_CONCLUSIVELY_ABSENT"
    ],
    "constraints": [
      "alternative_state=DIFFERENCE nunca vira UNKNOWN apenas porque stdout difere bilateralmente",
      "alternative_state nunca concede MATCH ao membro qualificado ausente",
      "PARTIAL nunca esconde uma alternativa DIFFERENCE",
      "resultado de sibling nunca concede crédito",
      "erro de cast ou aridade nunca prova ausência",
      "Unknown nunca é promovido por default"
    ]
  },
