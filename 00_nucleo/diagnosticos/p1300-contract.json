  "execution_protocol": {
    "command_template": [
      "{product_binary}",
      "eval",
      "{expression}",
      "--format",
      "json",
      "{profile.argv_suffix...}"
    ],
    "working_directory": "fresh temporary directory",
    "environment_policy": "same explicit environment for oracle and candidate; do not inherit product-selecting variables",
    "timeout_ms": 10000,
    "encoding": "UTF-8",
    "comparison": "byte_exact_after_no_normalization",
    "binding_free_rule": "Only CLI exit status and public language output are observed. No source file, Rust symbol, scope storage, function pointer, insertion order or internal binding identity may be inspected."
  },
  "required_observables": [
    "process_completion",
    "exit_code",
    "stdout_bytes",
    "stderr_bytes",
    "diagnostic_class",
    "diagnostic_message",
    "diagnostic_hints_in_order",
    "rendered_span_bytes",
    "public_type",
    "public_repr",
    "representative_call_value",
    "color_space_identity",
    "feature_profile_invariance"
  ],
  "expectation_sources": {
    "pre_gate_measurement": {
      "path": "00_nucleo/diagnosticos/p1300-pre-gate-measurement.json",
      "sha256": "1678b1aed89bfff7581a8fdd998a32f57df18f134226e680596c587620ea3efe",
      "use": "Only outputs literally present in this file may be pinned here."
    },
    "confirmed_l0": {
      "use": "Closed inventories, values and digests explicitly ratified by the confirmed L0 may be pinned here."
    },
    "oracle_suite": {
      "producer": "P2_oracle_author",
      "state": "required_not_yet_frozen",
      "rule": "P2 must execute the declared probe parameters against the pinned vanilla binary and publish exact observations. Until that suite is complete and hashed, the affected case is Unknown and cannot satisfy a seal."
    }
  },
  "classification_policy": {
    "result_enum": ["Preserved", "Violated", "Unknown"],
    "closed": true,
    "Preserved": {
      "when": "The product completed and every required observable for the case is present and exactly equals its frozen expectation, including ordered hints and rendered span bytes.",
      "witness_required": false
    },
    "Violated": {
      "when": "The product completed sufficiently to expose at least one required observable that contradicts a frozen expectation.",
      "witness_required": true,
      "witness_fields": ["case_id", "profile", "observable", "expected", "actual"]
    },
    "Unknown": {
      "when": "The product or oracle is missing, timed out, has ambiguous identity, uses an unsupported parser construction, lacks a required observable, or depends on an oracle-suite expectation that is not yet frozen.",
      "witness_required": true,
      "allowed_reason_codes": [
        "timeout",
        "missing_product",
        "ambiguous_product_identity",
        "unsupported_parser_construction",
        "incomplete_observation",
        "oracle_not_frozen"
      ]
    },
    "priority": [
      "deliberately_opaque_fixture_with_matching_reason_is_Unknown",
      "contradiction_with_complete_frozen_expectation_is_Violated",
      "all_complete_frozen_expectations_equal_is_Preserved",
      "otherwise_is_Unknown"
    ],
    "success_rule": "Only Preserved is success for semantic cases. Unknown is success only for a case listed in opaque_calibration_cases whose expected classification is Unknown and whose reason code matches exactly."
  },
