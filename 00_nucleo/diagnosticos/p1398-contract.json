      "subject": "every string literal emitted inside Symbol::repr",
      "mapping": {
        "U+0027_APOSTROPHE": "literal apostrophe without backslash",
        "U+0022_DOUBLE_QUOTE": "exactly one backslash followed by the quote",
        "U+0000_NUL": "exactly \\u{0}",
        "U+005C_BACKSLASH": "canonical doubled backslash",
        "U+000A_NEWLINE": "exactly \\n",
        "U+0009_TAB": "exactly \\t",
        "U+000D_CARRIAGE_RETURN": "exactly \\r",
        "ZWJ_AND_VARIATION_SELECTORS": "preserve current lowercase Unicode escapes and the complete grapheme"
      },
      "must_not": [
        "recognize quote, sym, math, single, double, witness glyphs, or variant positions",
        "apply a second escaping pass",
        "truncate or normalize a grapheme"
      ]
    },
    {
      "id": "P1398-UNIFORM-COVERAGE",
      "subject": "simple symbols, bases, variant values, and every other string emitted by the Symbol owner",
      "must": "Apply one semantic mapping uniformly while preserving variant filtering, ordering, modifier trimming, and compact/multiline formatting.",
      "must_not": [
        "fix only runtime symbols",
        "fix only bases or only variants",
        "fix only sym.quote or math.quote"
      ]
    }
