digraph {

    graph [
        label="typst",
        labelloc=t,

        pad=0.4,

        // Consider rendering the graph using a different layout algorithm, such as:
        // [dot, neato, twopi, circo, fdp, sfdp]
        layout=neato,
        overlap=false,
        splines="line",
        rankdir=LR,

        fontname="Helvetica", 
        fontsize="36",
    ];

    node [
        fontname="monospace",
        fontsize="10",
        shape="record",
        style="filled",
    ];

    edge [
        fontname="monospace",
        fontsize="10",
    ];

    "std::path::PathBuf" [label="external struct|std::path::PathBuf", fillcolor="#81c169"]; // "struct" node
    "std::process::ExitCode" [label="external struct|std::process::ExitCode", fillcolor="#81c169"]; // "struct" node
    "typst" [label="crate|typst", fillcolor="#5397c8"]; // "crate" node
    "typst::drain_to_stderr" [label="pub(crate) fn|typst::drain_to_stderr", fillcolor="#f8c04c"]; // "fn" node
    "typst::eviction" [label="pub(crate) mod|typst::eviction", fillcolor="#f8c04c"]; // "mod" node
    "typst::eviction::crystalline_evict" [label="pub fn|typst::eviction::crystalline_evict", fillcolor="#81c169"]; // "fn" node
    "typst::main" [label="pub(crate) fn|typst::main", fillcolor="#f8c04c"]; // "fn" node
    "typst_core::contracts::world::World" [label="external trait|typst_core::contracts::world::World", fillcolor="#81c169"]; // "trait" node
    "typst_core::entities::source::Source" [label="external struct|typst_core::entities::source::Source", fillcolor="#81c169"]; // "struct" node
    "typst_core::entities::source_result::SourceDiagnostic" [label="external struct|typst_core::entities::source_result::SourceDiagnostic", fillcolor="#81c169"]; // "struct" node
    "typst_infra::fonts::discover_fonts" [label="external fn|typst_infra::fonts::discover_fonts", fillcolor="#81c169"]; // "fn" node
    "typst_infra::pipeline::compile_to_pdf_bytes_full_error" [label="external fn|typst_infra::pipeline::compile_to_pdf_bytes_full_error", fillcolor="#81c169"]; // "fn" node
    "typst_infra::world::SystemWorld" [label="external struct|typst_infra::world::SystemWorld", fillcolor="#81c169"]; // "struct" node
    "typst_shell::cli" [label="external mod|typst_shell::cli", fillcolor="#81c169"]; // "mod" node
    "typst_shell::cli::RunIntent" [label="external struct|typst_shell::cli::RunIntent", fillcolor="#81c169"]; // "struct" node
    "typst_shell::diagnostic::format_diagnostic" [label="external fn|typst_shell::diagnostic::format_diagnostic", fillcolor="#81c169"]; // "fn" node

    "typst" -> "std::path::PathBuf" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "std::process::ExitCode" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst::drain_to_stderr" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "typst" -> "typst::eviction" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "typst" -> "typst::main" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "typst" -> "typst_core::contracts::world::World" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst_core::entities::source::Source" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst_core::entities::source_result::SourceDiagnostic" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst_infra::fonts::discover_fonts" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst_infra::pipeline::compile_to_pdf_bytes_full_error" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst_infra::world::SystemWorld" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst_shell::cli" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst_shell::cli::RunIntent" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst" -> "typst_shell::diagnostic::format_diagnostic" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst::drain_to_stderr" -> "typst_core::entities::source::Source" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst::drain_to_stderr" -> "typst_core::entities::source_result::SourceDiagnostic" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge
    "typst::eviction" -> "typst::eviction::crystalline_evict" [label="owns", color="#000000", style="solid"] [constraint=true]; // "owns" edge
    "typst::main" -> "std::process::ExitCode" [label="uses", color="#7f7f7f", style="dashed"] [constraint=false]; // "uses" edge

}
