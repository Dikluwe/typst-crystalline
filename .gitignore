# General
.vscode
.idea
.codex/
_things
desktop.ini
.DS_Store

# Tests and benchmarks
tests/store
tests/suite/**/*.pdf
tests/fuzz/target
tests/fuzz/corpus
tests/fuzz/artifacts
tests/fuzz/coverage
