/parity/

# Parity scratch outputs (sources and fixtures remain visible to Git)
/lab/parity/matrix/fixtures/p1240/

# Temporary files and outputs
# Probe tasks create numbered scratch directories (temp_p581, temp_p763h, ...);
# one glob avoids adding a new ignore line for each task.
/temp_p*/
/test_output.txt
/perf.data
/dependencias.txt
/temp/
/.typ/*
00_nucleo/diagnosticos/p916-work/
*.profraw
*.profdata

/tmp/
