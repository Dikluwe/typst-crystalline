      "--offline",
      "--locked",
      "--target-dir",
      "lab/target/product",
      "-p",
      "typst-core",
      "-p",
      "typst-infra",
      "-p",
      "typst-shell",
      "-p",
      "typst-wiring"
    ]
  },
  {
    "name": "integrated-validation",
