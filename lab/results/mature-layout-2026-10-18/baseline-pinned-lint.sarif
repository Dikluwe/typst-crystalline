              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "id": "V7",
              "name": "OrphanPrompt",
              "shortDescription": {
                "text": "Prompt without any materialization in L1–L4"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "id": "V8",
              "name": "AlienFile",
              "shortDescription": {
