-        FrameItem::Text { pos, text, style } => {
-            let pdf_y = page_height - pos.y.val();
-            match ctx.mode {
-                StreamMode::Compact => emit_text_pdf(
-                    &mut ops,
-                    pos.x.val(),
-                    pdf_y,
-                    text.as_str(),
-                    style,
-                    &ctx.font_scenario,
-                ),
-                StreamMode::Verbose => emit_text_pdf_verbose(
-                    &mut ops,
