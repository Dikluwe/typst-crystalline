-            styles: &mut styles,
-            show_rules: &mut show_rules,
-            active_guards: &mut active_guards,
-            current_file: source.id(),
-            sink: &mut local_sink,
-        };
-        for request in requests {
-            *engine.styles = request.styles.clone();
-            let mut value = apply_func(
-                request.func.clone(),
