-/// **P611** — escapa caracteres XML especiais para texto dentro de elementos.
-fn escape_xml_text(s: &str) -> String {
-    let mut out = String::with_capacity(s.len());
-    for ch in s.chars() {
-        match ch {
-            '&' => out.push_str("&amp;"),
-            '<' => out.push_str("&lt;"),
-            '>' => out.push_str("&gt;"),
-            '"' => out.push_str("&quot;"),
-            '\'' => out.push_str("&apos;"),
-            ch => out.push(ch),
-        }
-    }
-    out
-}
