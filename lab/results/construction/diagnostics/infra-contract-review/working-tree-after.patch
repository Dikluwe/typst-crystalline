-        "<< /Length {len} /N 3 /Range [0 1 0 1 0 1] /Filter /FlateDecode >>\nstream\n"
-    );
-    let mut obj = header.into_bytes();
-    obj.extend_from_slice(&compressed);
-    obj.extend_from_slice(b"\nendstream");
-    obj
-}
