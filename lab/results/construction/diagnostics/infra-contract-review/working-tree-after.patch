-        self.read_bytes_cached(id).map_err(|e| match e {
-            FileError::NotFound => {
-                format!("file not found (searched at {})", full_path.display())
-            }
-            FileError::Other(msg) if msg.contains("access denied") => {
-                "failed to load file (access denied)".to_string()
