-    ops: &mut String,
-    pos_x: f64,
-    base_y: f64,
-    fill: &Option<typst_core::entities::layout_types::Color>,
-) {
-    if let Some(op) = fill.as_ref().and_then(spot_fill_operator) {
-        ops.push_str(&format!("q\n1 0 0 -1 {pos_x:.5} {base_y:.5} cm\n{op}BT\n"));
-        return;
