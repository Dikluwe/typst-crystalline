-fn adaptive_offsets_use_ratio_repr(gradient: &Gradient) -> bool {
-    use typst_core::entities::color::ColorSpace;
-
-    match gradient {
-        Gradient::Linear(value) => matches!(
-            value.space,
-            ColorSpace::Oklab
-                | ColorSpace::LinearRgb
-                | ColorSpace::Oklch
-                | ColorSpace::Hsl
-                | ColorSpace::Hsv
-        ),
-        Gradient::Radial(value) => matches!(
-            value.space,
-            ColorSpace::Oklab
-                | ColorSpace::LinearRgb
-                | ColorSpace::Oklch
-                | ColorSpace::Hsl
-                | ColorSpace::Hsv
-        ),
-        Gradient::Conic(_) => false,
-    }
