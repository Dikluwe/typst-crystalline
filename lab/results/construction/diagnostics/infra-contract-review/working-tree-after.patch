-/// Recebe e devolve `ops` por valor para que o braço `Link` possa chamar
-/// recursivamente sem conflitos de borrow.
-fn draw_item_top(
-    mut ops: String,
-    item: &FrameItem,
-    page_height: f64,
-    ctx: &PageContext,
