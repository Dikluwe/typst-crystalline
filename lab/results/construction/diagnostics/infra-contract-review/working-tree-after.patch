-        let mut tracked_sink = sink.track_mut();
-        let mut local_sink = TrackedMut::reborrow_mut(&mut tracked_sink);
-        let mut engine = Engine {
-            world,
-            font_metrics: &font_metrics,
-            route: route.track(),
