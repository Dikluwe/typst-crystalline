-```rust
-struct Snapshot {           // plugin.rs:420-426
-    mem_pages: u64,
-    mem_data: Vec<u8>,
-}
-
-struct PluginEntry {
-    base: Arc<PluginBase>,
-    /// `None` para módulos do `load`; `Some` para derivados de `transition`.
-    snapshot: Option<Snapshot>,
-}
