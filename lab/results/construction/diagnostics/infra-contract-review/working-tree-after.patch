-    match item {
-        // P483 — path primário: glifos com shaping real.
-        // **P956** — dispatch por modo: Compact = formato Passo 20
-        // byte-inalterado; Verbose = envelope vanilla-espelhado (mesma
-        // coordenada `pdf_y` — derivação F·F=I, stream.md §P956).
