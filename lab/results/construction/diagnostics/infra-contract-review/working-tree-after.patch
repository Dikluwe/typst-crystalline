-fn color_to_css(color: Color) -> String {
-    let (r, g, b, a) = color.to_srgb();
-    if a == 255 {
-        format!("#{r:02x}{g:02x}{b:02x}")
-    } else {
-        format!("rgba({r},{g},{b},{:.3})", a as f64 / 255.0)
-    }
-}
