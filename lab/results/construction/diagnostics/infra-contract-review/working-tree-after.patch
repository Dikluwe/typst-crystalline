-    /// **P786a** — comprimento textual total dos nós desde o marcador `m`
-    /// (usado pela regra vanilla `len() == 2` dos warnings de `**`/`__`).
-    pub(super) fn text_len_since(&self, m: Marker) -> usize {
-        self.nodes[m.0..].iter().map(SyntaxNode::len).sum()
