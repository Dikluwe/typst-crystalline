-```
-// Clones do mesmo Arc são iguais
-p1 = PtrEqArc(arc1); p2 = PtrEqArc(Arc::clone(&arc1)) → p1 == p2
-
-// Arcs diferentes com mesmo conteúdo são desiguais
-p1 = PtrEqArc(Arc::new(vec![1,2,3])); p3 = PtrEqArc(Arc::new(vec![1,2,3])) → p1 != p3
