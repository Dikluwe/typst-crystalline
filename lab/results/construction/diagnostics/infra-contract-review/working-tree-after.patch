-                StreamMode::Compact => emit_shaped_pdf(
-                    &mut ops,
-                    pos.x.val(),
-                    pdf_y,
-                    glyphs,
-                    text.as_str(),
-                    style,
-                    &ctx.font_scenario,
-                    *units_per_em,
-                ),
-                StreamMode::Verbose => emit_shaped_pdf_verbose(
-                    &mut ops,
-                    pos.x.val(),
-                    pdf_y,
-                    glyphs,
-                    text.as_str(),
-                    style,
-                    &ctx.font_scenario,
-                    *units_per_em,
-                ),
-            }
-        }
