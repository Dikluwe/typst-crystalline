+            let delta = correct_y - applied_y;
+            if delta == 0.0 {
+                continue;
+            }
+            if let Some(slice) = helpers::resolve_path_slice(items, &path, count) {
+                for item in slice {
+                    helpers::shift_frame_item_y(item, delta);
+                }
+            }
