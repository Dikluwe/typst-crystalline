-    pub char_code: char,  // Codepoint Unicode derivado de cluster
+    pub glyph_id: u16,
+    pub x_advance: i32,
+    pub x_offset: i32,
+    pub y_offset: i32,
+    pub cluster: u32,
+    pub char_code: char,
