-("a", "b").join()                  → "ab"
-("a",).join("-")                   → "a"
-().join("-")                       → none
-().join("-", default: "x")         → "x"
-("a", "b", "c").join("-", last: " and ") → "a-b and c"
-("a", "b").join("-", last: " and ")      → "a and b"
